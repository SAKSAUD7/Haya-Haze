# Copy to backend/.env. With nothing set, the backend runs in local mode:
# SQLite, in-memory cache, tasks run inline, emails printed to the console.

DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string-of-50-plus-characters
ALLOWED_HOSTS=localhost,127.0.0.1,backend
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Demo admin created by `python manage.py seed_demo`. Change before going live.
DJANGO_SUPERUSER_EMAIL=admin@hayaandhaze.com
DJANGO_SUPERUSER_PASSWORD=HayaHaze@2025

# --- Database and Redis (leave empty for local mode) ---
# DATABASE_URL=postgres://hayahaze:hayahaze@localhost:5432/hayahaze
# REDIS_URL=redis://localhost:6379/0

# --- Payments ---
# Razorpay: Dashboard > Account & Settings > API Keys.
# Empty keys with DEBUG=True enables clearly labelled sandbox payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks > add <BACKEND_URL>/api/v1/payments/razorpay/webhook/
# with events payment.captured and order.paid, and put its secret here.
RAZORPAY_WEBHOOK_SECRET=
# Stripe (international cards). Webhook: <BACKEND_URL>/api/v1/payments/stripe/webhook/
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Shipping (Shiprocket API user: Settings > API > Configure) ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
# Any secret you choose. Enter the same value as the x-api-key in the Shiprocket webhook settings.
# Webhook URL: <BACKEND_URL>/api/v1/shipping/webhook/shiprocket/
SHIPROCKET_WEBHOOK_TOKEN=

# --- Email (pick one; empty = print to console) ---
RESEND_API_KEY=
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Haya & Haze <hello@hayaandhaze.com>
ADMIN_NOTIFY_EMAIL=hello@hayaandhaze.com

# --- Media storage (empty = local disk). Any S3-compatible bucket. ---
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_CUSTOM_DOMAIN=cdn.hayaandhaze.com

# --- Sign in with Google (Google Cloud Console > Credentials > OAuth client) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Monitoring and ads ---
SENTRY_DSN=
META_PIXEL_ACCESS_TOKEN=
