# Copy to frontend/.env.local

# Public address of this storefront (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the Django backend is reachable FROM THE NEXT.JS SERVER.
# The browser never calls it directly: /api and /media are proxied through Next.js.
API_INTERNAL_URL=http://127.0.0.1:8000
